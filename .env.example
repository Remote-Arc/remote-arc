# Development-only agent configuration.
# Normal users should run: npx remotelink
REMOTE_LINK_DEVICE_ID=
REMOTE_LINK_DEVICE_NAME=
REMOTE_LINK_DEVICE_TOKEN=
REMOTE_LINK_RELAY_URL=wss://remotearc.app
REMOTE_LINK_MODE=developer

# Local MCP permissions: safe | developer | full
REMOTE_LINK_ALLOW_CORE_CALL=0

# Relay Google OAuth (set as Wrangler secrets in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Relay mail: use Wrangler secrets in production; local Worker values go in .dev.vars.
# OTP prefers Resend and automatically borrows SendPulse capacity when needed.
# Follow-ups use only the selected provider and yield capacity to OTP.
RESEND_API_KEY=
EMAIL_AUTH_SECRET=
FOLLOWUP_EMAIL_PROVIDER=resend
SENDPULSE_API_KEY=
# Optional allocation overrides; blank values use provider defaults.
FOLLOWUP_HOURLY_EMAIL_LIMIT=
FOLLOWUP_DAILY_EMAIL_LIMIT=
FOLLOWUP_MONTHLY_EMAIL_LIMIT=
# Shared account ceilings; blank values use conservative free-plan defaults.
RESEND_DAILY_EMAIL_LIMIT=
RESEND_MONTHLY_EMAIL_LIMIT=
SENDPULSE_HOURLY_EMAIL_LIMIT=
SENDPULSE_DAILY_EMAIL_LIMIT=
SENDPULSE_MONTHLY_EMAIL_LIMIT=

# Optional comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=

# Experimental Browser Runner H.264 video. Agent requires an existing FFmpeg;
# no binary is bundled or downloaded by remotelink. Defaults to JPEG when unset.
REMOTEARC_RUNNER_VIDEO=0
REMOTEARC_FFMPEG_PATH=
REMOTEARC_VIDEO_ENCODER=

# Relay: use Wrangler secrets for the dedicated Cloudflare Realtime SFU app.
# Never expose APP_SECRET to the Agent, viewer, tool output, or build variables.
RUNNER_VIDEO_ENABLED=0
RUNNER_VIDEO_APP_ID=
RUNNER_VIDEO_APP_SECRET=
