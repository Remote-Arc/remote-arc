{
  "manifest_version": 3,
  "name": "Remote Arc Browser",
  "version": "0.4.0",
  "description": "Share individual tabs or opt in to a whole-browser session, with explicit read and interaction controls.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mcp.remotearc.app/*"
  ],
  "action": {
    "default_title": "Remote Arc Browser",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
