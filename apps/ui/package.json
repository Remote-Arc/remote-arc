{
  "name": "@remotearc/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:onboarding": "node scripts/onboarding-flow-test.mjs",
    "test:arc-experience": "node scripts/arc-capabilities-test.mjs && node --experimental-strip-types scripts/marketing-playback-test.mjs && node --import tsx scripts/arc-positioning-test.mjs && node --import tsx scripts/home-panorama-test.mjs && node --import tsx scripts/apps-demo-contract-test.mjs",
    "test:onboarding-readability": "node scripts/onboarding-readability-test.mjs",
    "test:device-removal": "node scripts/device-removal-test.mjs",
    "test:device-execution-log": "node scripts/device-execution-log-test.mjs",
    "test:security": "node scripts/security-response-test.mjs && node --experimental-strip-types scripts/security-grant-groups-test.mjs",
    "test:background-recovery": "node --experimental-strip-types scripts/background-recovery-test.mjs"
  },
  "dependencies": {
    "@remotearc/protocol": "workspace:*",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.7",
    "typescript": "^6.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "react-test-renderer": "19.3.0",
    "tsx": "4.23.15"
  }
}
