{
  "name": "remotearc-monorepo",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:site": "node scripts/run-task.mjs root test:site",
    "test:site:types": "pnpm --filter @remotearc/ui exec tsc -p ../../tests/site/tsconfig.json",
    "test:site:browser": "pnpm exec playwright test",
    "dev:mcp": "go -C apps/agent run ./cmd/remotelink --mcp",
    "dev:agent": "go -C apps/agent run ./cmd/remotelink --foreground",
    "dev:relay": "pnpm --filter @remotearc/relay dev",
    "dev:ui": "pnpm --filter @remotearc/ui dev",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/run-task.mjs root test",
    "test:automations": "node scripts/run-task.mjs root test:automations",
    "test:recovery": "node scripts/run-task.mjs root test:recovery",
    "test:agent-log": "go -C apps/agent test ./internal/journal",
    "test:goals": "node scripts/run-task.mjs root test:goals",
    "ci": "node scripts/run-task.mjs root ci",
    "build:ui": "node scripts/run-task.mjs root build:ui",
    "deploy:relay": "node scripts/deploy-relay.mjs",
    "test:installer": "node scripts/native-installer-test.mjs",
    "test:wiring": "node scripts/run-task.mjs root test:wiring",
    "test:deploy-policy": "node scripts/run-task.mjs root test:deploy-policy",
    "test:organization": "node scripts/organization-foundation-test.mjs",
    "build:cli": "pnpm --filter remotelink build",
    "build:device": "node scripts/run-task.mjs root build:device",
    "test:device": "node scripts/run-task.mjs root test:device",
    "test:coverage-badges": "node --test scripts/coverage-badges-test.mjs",
    "coverage:go": "node scripts/go-coverage.mjs",
    "coverage:go:target": "node scripts/go-coverage.mjs --target",
    "coverage:apps": "node scripts/run-task.mjs root coverage:apps",
    "coverage:relay": "node scripts/relay-coverage.mjs",
    "coverage:relay:target": "node scripts/relay-coverage.mjs --target",
    "coverage:ts": "node scripts/ts-coverage.mjs",
    "coverage:ts:target": "node scripts/ts-coverage.mjs --target",
    "test:device:soak": "node scripts/go-device-soak.mjs",
    "benchmark:core": "node scripts/run-task.mjs root benchmark:core",
    "benchmark:agent": "node scripts/run-task.mjs root benchmark:agent",
    "publish:cli": "node scripts/publish-cli.mjs",
    "test:browser": "node apps/browser-extension/test.mjs",
    "test:browser:e2e": "node apps/browser-extension/e2e.mjs",
    "test:seo": "node scripts/run-task.mjs root test:seo",
    "package:browser": "node scripts/package-browser-extension.mjs",
    "test:release-notify": "node .github/scripts/release-ready-notify-test.mjs",
    "test:fleet": "node scripts/run-task.mjs root test:fleet",
    "test:skills": "node scripts/run-task.mjs root test:skills",
    "docs:tools": "pnpm --filter @remotearc/relay exec tsx scripts/generate-tool-reference.ts",
    "test:media-integration": "node scripts/media-intelligence-integration.mjs",
    "docs:tools:check": "pnpm docs:tools --check",
    "docs:architecture:check": "node scripts/architecture-doc-check.mjs",
    "apps:inventory": "pnpm --filter @remotearc/relay exec tsx ../../scripts/app-tool-inventory.ts",
    "test:runtime-surface": "node scripts/runtime-surface-check.mjs",
    "release:sync": "node scripts/sync-release-docs.mjs --write",
    "release:check": "node scripts/sync-release-docs.mjs --check",
    "release:notes": "node scripts/sync-release-docs.mjs --notes",
    "saas:economics": "node tools/saas/cli.mjs",
    "saas:tools": "node tools/saas/cli.mjs --serve",
    "test:saas": "node scripts/run-task.mjs root test:saas",
    "arc:setup": "node scripts/arc-platform-setup.mjs",
    "billing:setup": "pnpm --filter @remotearc/relay exec tsx ../../scripts/stripe-billing-setup.ts",
    "saas:apps": "node tools/saas/apps.mjs",
    "task": "node scripts/run-task.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "node scripts/run-task.mjs root check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.6",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
