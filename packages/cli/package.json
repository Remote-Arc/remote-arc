  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "ws": "^8.22.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://remotearc.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Remote-Arc/remote-arc.git",
