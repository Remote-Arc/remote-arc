{
  "name": "remotelink",
  "version": "0.6.5",
  "description": "Controlled remote computer access for AI across computers you own.",
  "type": "module",
  "bin": {
    "remotelink": "dist/index.js",
    "remote-link": "dist/index.js",
    "remote-arc": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
